#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
export PATH="$REPO_ROOT/.tools/bin:${PATH:-}"
ASC_ROOT="${ASC_ROOT:-$REPO_ROOT/.tools/ASC}"
ASC_PY="${ASC_ROOT}/.venv/bin/python"
ASC_MAIN="${ASC_ROOT}/main.py"
ENSURE="$REPO_ROOT/scripts/ensure-tools.sh"

if [[ ! -x "$ASC_PY" || ! -f "$ASC_MAIN" ]]; then
  if [[ -x "$ENSURE" ]]; then
    "$ENSURE" asc
  fi
fi

if [[ ! -x "$ASC_PY" || ! -f "$ASC_MAIN" ]]; then
  echo "ASC is not installed: $ASC_ROOT" >&2
  echo "Run: $ENSURE asc" >&2
  exit 127
fi

exec "$ASC_PY" "$ASC_MAIN" "$@"
